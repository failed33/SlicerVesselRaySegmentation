+#if components > 1
+          var x_value = Accumulator(0);
+          for (var lane = 0u; lane < components; lane++) {
+            let x_indices = x_indices_t(batch, input_channel + lane, id, ih, iw);
+            x_value[lane] = f32(x.getByIndices(x_indices));
+          }
+#else
+          let x_indices = x_indices_t(batch, input_channel, id, ih, iw);
+          let x_value = f32(x.getByIndices(x_indices));
